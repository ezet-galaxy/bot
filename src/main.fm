import std.net.http
import std.json
import std.env
import flamer



let bot_token: String? = env.get("BOT_TOKEN")
let webhook_url: String? = env.get("WEBHOOK_URL")

export async fn reply(update: &Formula, token: &String, replyText: String) -> Formula {
    let chat_id = update.message.chat.id
    let send_url = $"https://api.telegram.org/bot{token}/sendMessage"
    let payload = {

        chat_id: chat_id,
        text: replyText
    }

    let res: Formula? = await http.post(send_url, payload).json()

    // println($"Bot response: {res?.result.text}")
    return res
}


export async fn setWebhook(token: &String, webhookUrl: &String) -> Formula {
    let url = $"https://api.telegram.org/bot{token}/setWebhook"
    let payload = {

        url: webhookUrl
    }

    let response = await http.post(url, payload)
    let result = await response.json()

    // println($"Webhook response: {result}")
    return result
}

